# ─────────────────────────────────────────────────────────────
# 환경변수 예시
#
# 로컬: 이 파일을 .env.local로 복사한 뒤 값을 채웁니다.
#         cp .env.example .env.local
# 배포: Vercel 프로젝트 설정 → Environment Variables에 같은 값을 등록합니다.
#
# .env.local은 git에 올라가지 않습니다(.gitignore). 키를 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 문의 알림 메일 (Resend) ──────────────────────────────────
# https://resend.com → API Keys에서 발급
RESEND_API_KEY=

# 알림을 받을 주소 (비워 두면 content/site.ts의 기관 이메일로 발송)
INQUIRY_TO_EMAIL=thska89@naver.com

# 발신 주소. Resend에서 인증한 도메인의 주소여야 합니다.
# 도메인 인증 전에는 onboarding@resend.dev로 테스트할 수 있고,
# 이때는 Resend 계정에 등록된 본인 주소로만 발송됩니다.
INQUIRY_FROM_EMAIL=onboarding@resend.dev

# ── 문의 내역 저장 (Supabase) ────────────────────────────────
# Supabase 프로젝트 → Settings → API에서 확인
NEXT_PUBLIC_SUPABASE_URL=
# service_role 키는 RLS를 우회합니다. 서버(API 라우트)에서만 쓰이며
# 절대 클라이언트에 노출하면 안 됩니다. anon 키와 혼동하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 사이트 주소 (선택) ───────────────────────────────────────
# og:image·canonical 등 절대 URL 생성에 쓰입니다. 도메인 연결 후 채우세요.
NEXT_PUBLIC_SITE_URL=https://kexpertedu.co.kr
